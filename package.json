{
  "name": "core",
  "version": "0.3.0",
  "description": "CORE - 3D 무인 원격 제어 FPS/핵앤슬래시 게임 (Web-First)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && node tests/e2e/smoke.mjs",
    "build:map": "node scripts/build-pipeline.mjs",
    "gen:cities": "node scripts/gen-city-config.mjs",
    "validate:world": "node scripts/validate-world.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.1.8"
  }
}
