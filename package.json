{
  "name": "core",
  "version": "0.3.0",
  "description": "CORE - 3D 무인 원격 제어 3인칭 슈터/핵앤슬래시 게임 (Web-First)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && node tests/e2e/smoke.mjs",
    "build:map": "node scripts/build-pipeline.mjs",
    "gen:cities": "node scripts/gen-city-config.mjs",
    "audit:landmarks": "node scripts/audit-landmarks.mjs",
    "validate:world": "node scripts/validate-world.mjs",
    "test:fast": "vitest run --project fast",
    "test:extended": "vitest run --project extended",
    "build:seoul-bundles": "node scripts/build-seoul-bundles.mjs",
    "prebuild": "node scripts/verify-map-bundles.mjs",
    "pretest": "python3 scripts/map-release.py ensure && python3 scripts/map-release.py ensure --city busan",
    "maps:restore": "python3 scripts/map-release.py restore",
    "maps:publish": "npm run build:seoul-bundles && python3 scripts/map-release.py publish",
    "maps:verify": "node scripts/verify-map-bundles.mjs",
    "build:busan-bundles": "node scripts/build-map-bundles.mjs busan",
    "maps:restore:busan": "python3 scripts/map-release.py restore --city busan",
    "maps:publish:busan": "npm run build:busan-bundles && python3 scripts/map-release.py publish --city busan"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.1.8"
  }
}
